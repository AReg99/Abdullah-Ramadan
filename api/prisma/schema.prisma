// Aura — Phase 1 (the tracking spine).
// Mirrors docs/04-data-model.md. Later phases add materials, BOM, logistics,
// finance and after-sales; the seams for those are noted in the docs, not stubbed here.

generator client {
  provider      = "prisma-client-js"
  // Built inside Alpine containers that may be x86 or Arm — Hetzner's cheapest
  // plans are Ampere Arm. Declaring both targets means the same image builds on
  // either, instead of failing at runtime with a missing query engine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

enum RoleKey {
  OWNER
  FACTORY_MANAGER
  SUPERVISOR
  GROUP_LEADER
  QC
  STOREKEEPER
  SHOWROOM_MANAGER
  SALES_REP
  DRIVER
  ACCOUNTANT
}

enum Locale {
  ar
  en
}

model Role {
  id          String  @id @default(uuid())
  key         RoleKey @unique
  nameAr      String
  nameEn      String
  permissions Json    @default("[]")
  users       User[]
}

/// People. Only some of them sign in.
///
/// The floor runs on groups: a group leader carries the phone and operates the
/// app, and the workers in their group do not sign in at all. Workers still
/// exist as records so output and rework stay attributable to the people who
/// did the work — losing that would cost the productivity and quality reports.
/// Company-wide configuration: VAT, the letterhead, anything an owner changes
/// without a deploy. Key/value because the alternative is a migration every
/// time the tax rate moves.
/// A counter per document series, incremented under a transaction so two
/// people invoicing at the same second cannot be handed the same number.
model DocumentSequence {
  key  String @id
  next Int    @default(1)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id           String    @id @default(uuid())
  nameAr       String
  nameEn       String
  /// Unique only where present: roster workers have no phone and never sign in.
  phone        String?   @unique
  email        String?   @unique
  passwordHash String?
  /// False for roster workers — they are tracked, not authenticated.
  canLogin     Boolean   @default(true)
  locale       Locale    @default(ar)
  isActive     Boolean   @default(true)
  /// How this person is paid. Most of a furniture factory is on a day rate and
  /// paid weekly; the office is usually monthly. Both exist in the same payroll.
  payType      PayType   @default(MONTHLY)
  /// Monthly wage. Null means "not on the payroll" — most roster workers are
  /// paid by the crew, and a zero would look like a decision rather than a gap.
  salary       Decimal?  @db.Decimal(14, 2)
  /// What one day is worth, for anybody paid by the day.
  dayRate      Decimal?  @db.Decimal(14, 2)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  stationId    String?
  station      Station?  @relation(fields: [stationId], references: [id])
  /// The group this person belongs to, whether as leader or member.
  groupId      String?
  group        Group?    @relation("GroupMembers", fields: [groupId], references: [id])
  /// Showroom staff belong to a location; a null means "every showroom".
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  createdAt    DateTime  @default(now())

  leads         Group[]           @relation("GroupLeader")
  stages        WorkOrderStage[]
  stageWork     StageWorker[]
  photos        StagePhoto[]
  events        TrackingEvent[]
  otps          OtpCode[]
  uploads       OrderAttachment[] @relation("AttachmentAuthor")
  productPhotos ProductPhoto[]    @relation("ProductPhotoAuthor")
  cashEntries   CashEntry[]       @relation("CashEntryAuthor")
  purchases     PurchaseInvoice[] @relation("PurchaseAuthor")
  payslips      PayrollLine[]
  payAdjustments PayrollAdjustment[]
  payrollRuns   PayrollRun[]      @relation("PayrollAuthor")
  stockMoves    StockMovement[]   @relation("StockAuthor")
  stocktakes    Stocktake[]       @relation("StocktakeAuthor")
  attendance    Attendance[]      @relation("AttendanceOf")
  attendanceTaken Attendance[]    @relation("AttendanceAuthor")
}

/// A crew working one station under one leader.
model Group {
  id        String   @id @default(uuid())
  nameAr    String
  nameEn    String
  stationId String
  station   Station  @relation(fields: [stationId], references: [id])
  leaderId  String?
  leader    User?    @relation("GroupLeader", fields: [leaderId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  members User[]           @relation("GroupMembers")
  stages  WorkOrderStage[]
}

/// Which workers were actually on a stage. The leader records this when they
/// start the job, so a stage has both an operator (the leader) and a crew.
model StageWorker {
  id               String         @id @default(uuid())
  workOrderStageId String
  workOrderStage   WorkOrderStage @relation(fields: [workOrderStageId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])

  @@unique([workOrderStageId, userId])
}

model OtpCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- places

enum LocationType {
  FACTORY
  SHOWROOM
  WAREHOUSE
}

model Location {
  id       String          @id @default(uuid())
  type     LocationType
  nameAr   String
  nameEn   String
  address  String?
  stations Station[]
  orders    Order[]
  events    TrackingEvent[]
  staff     User[]
  soldFrom  OrderLine[]         @relation("LineWarehouse")
  received  PurchaseInvoiceLine[]
  stock     StockMovement[]
  stocktakes Stocktake[]
}

model Station {
  id                   String   @id @default(uuid())
  code                 String   @unique
  nameAr               String
  nameEn               String
  locationId           String
  location             Location @relation(fields: [locationId], references: [id])
  dailyCapacityMinutes Int      @default(480)
  isActive             Boolean  @default(true)

  users         User[]
  groups        Group[]
  routingStages RoutingStage[]
  events        TrackingEvent[]
}

// ---------------------------------------------------------------- catalogue

model ProductCategory {
  id       String    @id @default(uuid())
  nameAr   String
  nameEn   String
  products Product[]
  routings Routing[]
}

enum ProductKind {
  STANDARD
  CUSTOMIZABLE
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  nameAr         String
  nameEn         String
  kind           ProductKind     @default(STANDARD)
  basePrice      Decimal         @db.Decimal(14, 2)
  /// What the piece costs to make. Margin is a lie without it.
  cost           Decimal         @default(0) @db.Decimal(14, 2)
  baseLeadDays   Int             @default(14)
  /// The line the showroom reads to the customer. Marketing copy, not a spec.
  description    String?
  warrantyMonths Int             @default(24)
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id])
  isActive       Boolean         @default(true)

  orderLines OrderLine[]
  workOrders WorkOrder[]
  photos     ProductPhoto[]
  stockItem  StockItem?
  bom        BomLine[]
}

// ---------------------------------------------------------------- sales

model Customer {
  id       String  @id @default(uuid())
  name     String
  phone    String
  whatsapp String?
  email    String?
  address  String?
  locale   Locale  @default(ar)
  orders   Order[]
}

enum OrderKind {
  STANDARD
  CUSTOM
  MIXED
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

enum OrderChannel {
  SHOWROOM
  FACTORY
  ONLINE
}

enum OrderStatus {
  DRAFT
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CLOSED
  CANCELLED
}

enum LineKind {
  STANDARD
  CUSTOM
}

enum LineStatus {
  PENDING
  QUEUED
  IN_PRODUCTION
  /// Made, still in the factory, waiting to be sent.
  FINISHED
  /// Left the factory, not yet signed for at the showroom.
  IN_TRANSIT
  /// At the showroom, waiting for the customer.
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id            String       @id @default(uuid())
  code          String       @unique
  kind          OrderKind    @default(STANDARD)
  channel       OrderChannel @default(SHOWROOM)
  status        OrderStatus  @default(CONFIRMED)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  showroomId    String?
  showroom      Location?    @relation(fields: [showroomId], references: [id])
  promisedDate  DateTime?
  /// The lines before tax. total is what the customer actually pays.
  subtotal      Decimal      @default(0) @db.Decimal(14, 2)
  /// The sum of the lines' discounts, kept on the order so the invoice can
  /// print "you were given this much off" as its own line.
  discountTotal Decimal      @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal      @default(0) @db.Decimal(14, 2)
  /// The rate this order was written at, kept so an old invoice reprints as it
  /// was issued rather than at today's rate.
  taxRate       Decimal      @default(0) @db.Decimal(5, 2)
  total         Decimal      @default(0) @db.Decimal(14, 2)
  paidTotal     Decimal      @default(0) @db.Decimal(14, 2)
  currency      String       @default("EGP")
  /// The invoice number, from our own series. Separate from the order code
  /// because the two answer to different people: the code is how the factory
  /// talks about the job, the number is what the tax authority counts.
  invoiceNo     String?      @unique
  trackingToken String       @unique
  createdAt     DateTime     @default(now())

  lines       OrderLine[]
  events      TrackingEvent[]
  attachments OrderAttachment[]
  payments    CashEntry[]

  @@index([status, promisedDate])
}

/**
 * What the piece looks like. A catalogue with no pictures is a price list: the
 * showroom cannot show it, and the leader building it cannot check what they
 * are aiming at.
 */
model ProductPhoto {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filename   String
  path       String
  mime       String
  bytes      Int      @default(0)
  /// Lowest first. The first is the one shown wherever there is room for one.
  sortOrder  Int      @default(0)
  uploadedAt DateTime @default(now())
  actorId    String?
  actor      User?    @relation("ProductPhotoAuthor", fields: [actorId], references: [id])

  @@index([productId, sortOrder])
}

/**
 * What the customer brought with the order: a photo of the piece they want
 * copied, a room measurement, a signed quotation. The showroom has it in hand
 * at the moment of sale and the factory needs it three weeks later, which is
 * exactly the gap a paper folder loses it in.
 */
model OrderAttachment {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       AttachmentKind @default(IMAGE)
  filename   String
  path       String
  mime       String
  bytes      Int            @default(0)
  note       String?
  uploadedAt DateTime       @default(now())
  actorId    String?
  actor      User?          @relation("AttachmentAuthor", fields: [actorId], references: [id])

  @@index([orderId])
}

model OrderLine {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qty          Int        @default(1)
  unitPrice    Decimal    @db.Decimal(14, 2)
  /// Money off this line, in currency rather than percent: a discount is
  /// almost always argued in pounds across a counter, not in percentages.
  discount     Decimal    @default(0) @db.Decimal(14, 2)
  /// The cost on the day it was sold. Copied, not looked up, so last year's
  /// margin does not move when this year's timber does.
  unitCost     Decimal    @default(0) @db.Decimal(14, 2)
  /// Which store the piece came out of. The invoice has to say, and a
  /// stock count later cannot be reconstructed without it.
  warehouseId  String?
  warehouse    Location?  @relation("LineWarehouse", fields: [warehouseId], references: [id])
  lineKind     LineKind   @default(STANDARD)
  status       LineStatus @default(PENDING)
  promisedDate DateTime?
  specNotes    String?
  /// Handover milestones, projected from the event stream for cheap reads.
  dispatchedAt DateTime?
  receivedAt   DateTime?
  deliveredAt  DateTime?

  workOrders WorkOrder[]

  @@index([status, promisedDate])
}

// ---------------------------------------------------------------- production

model Routing {
  id         String           @id @default(uuid())
  nameAr     String
  nameEn     String
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  isDefault  Boolean          @default(false)
  stages     RoutingStage[]
  workOrders WorkOrder[]
}

/// Photo gates, per stage and per direction. See docs/03-order-lifecycle.md.
enum PhotoRule {
  OFF
  OPTIONAL
  REQUIRED
}

model RoutingStage {
  id                String    @id @default(uuid())
  routingId         String
  routing           Routing   @relation(fields: [routingId], references: [id], onDelete: Cascade)
  seq               Int
  key               String
  nameAr            String
  nameEn            String
  stationId         String
  station           Station   @relation(fields: [stationId], references: [id])
  stdMinutes        Int
  isCustomerVisible Boolean   @default(false)
  photoBefore       PhotoRule @default(OFF)
  photoAfter        PhotoRule @default(OFF)
  photoMinCount     Int       @default(1)

  workOrderStages WorkOrderStage[]

  @@unique([routingId, seq])
}

enum WorkOrderStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
}

model WorkOrder {
  id           String          @id @default(uuid())
  code         String          @unique
  orderLineId  String
  orderLine    OrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  qty          Int             @default(1)
  routingId    String
  routing      Routing         @relation(fields: [routingId], references: [id])
  status       WorkOrderStatus @default(PENDING)
  priority     Int             @default(0)
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  createdAt    DateTime        @default(now())

  stages WorkOrderStage[]
  labels UnitLabel[]
  photos StagePhoto[]
}

enum StageStatus {
  PENDING
  READY
  IN_PROGRESS
  PAUSED
  DONE
  /// The order was cancelled before this stage was worked. Distinct from
  /// PENDING, which means it is still coming.
  CANCELLED
}

/// Fixed list — free text cannot be reported on. docs/03-order-lifecycle.md.
enum BlockedReason {
  NO_MATERIAL
  MACHINE_DOWN
  AWAITING_DRAWING
  AWAITING_QC
  AWAITING_CUSTOMER
  MISSING_COMPONENT
  POWER
  LABOUR_SHORT
  OTHER
}

model WorkOrderStage {
  id             String         @id @default(uuid())
  workOrderId    String
  workOrder      WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  routingStageId String
  routingStage   RoutingStage   @relation(fields: [routingStageId], references: [id])
  seq            Int
  status         StageStatus    @default(PENDING)
  /// The leader who operated the app for this stage.
  assignedToId   String?
  assignedTo     User?          @relation(fields: [assignedToId], references: [id])
  /// The crew it was assigned to.
  groupId        String?
  group          Group?         @relation(fields: [groupId], references: [id])
  startedAt      DateTime?
  finishedAt     DateTime?
  actualMinutes  Int            @default(0)
  blockedReason  BlockedReason?
  blockedNote    String?
  blockedMinutes Int            @default(0)
  pausedAt       DateTime?

  photos  StagePhoto[]
  workers StageWorker[]

  @@unique([workOrderId, seq])
  @@index([status])
}

model UnitLabel {
  id          String       @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  serial      String       @unique
  printedAt   DateTime?
  scrapped    Boolean      @default(false)
  photos      StagePhoto[]
}

enum PhotoKind {
  BEFORE
  AFTER
  ISSUE
  EXTRA
}

model StagePhoto {
  id                String         @id @default(uuid())
  workOrderStageId  String
  workOrderStage    WorkOrderStage @relation(fields: [workOrderStageId], references: [id], onDelete: Cascade)
  workOrderId       String
  workOrder         WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  unitLabelId       String?
  unitLabel         UnitLabel?     @relation(fields: [unitLabelId], references: [id])
  kind              PhotoKind
  path              String
  bytes             Int            @default(0)
  width             Int            @default(0)
  height            Int            @default(0)
  capturedAt        DateTime
  uploadedAt        DateTime       @default(now())
  actorId           String
  actor             User           @relation(fields: [actorId], references: [id])
  clientEventId     String         @unique
  isCustomerVisible Boolean        @default(false)
  caption           String?

  @@index([workOrderStageId, kind])
}

// ---------------------------------------------------------------- the event stream

/// Append-only. Nothing is ever updated; a mistake is corrected by a new
/// compensating event. occurredAt is the device clock; recordedAt is the server's,
/// so an offline scan still counts at the minute it happened.
model TrackingEvent {
  id                String    @id @default(uuid())
  code              String
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id])
  entityType        String
  entityId          String
  actorId           String?
  actor             User?     @relation(fields: [actorId], references: [id])
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id])
  stationId         String?
  station           Station?  @relation(fields: [stationId], references: [id])
  payload           Json      @default("{}")
  occurredAt        DateTime
  recordedAt        DateTime  @default(now())
  isCustomerVisible Boolean   @default(false)
  clientEventId     String?   @unique

  @@index([orderId, occurredAt])
  @@index([code, occurredAt])
  @@index([occurredAt])
}

// ─────────────────────────────────────────────────────────── money
// Every movement of money is one CashEntry against one account. A collection
// from a customer, a payment to a supplier and a running expense are the same
// shape — direction, amount, where it landed — which is what makes the cash box
// add up without a second set of books to reconcile against.

enum CashAccountKind {
  CASH
  BANK
}

/// A drawer or a bank account. الخزنة.
model CashAccount {
  id             String          @id @default(uuid())
  code           String          @unique
  nameAr         String
  nameEn         String
  kind           CashAccountKind @default(CASH)
  /// What was in it the day the books opened here.
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  entries     CashEntry[]
  payrollRuns PayrollRun[]
}

enum CashDirection {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  INSTAPAY
  CHEQUE
  CARD
}

/// What money out of the drawer was for, when it was not a supplier invoice.
/// What a movement was for, in or out. The name is historical — it started as
/// expenses only — and is left alone because renaming a live enum is a
/// migration nobody needs.
enum PayType {
  MONTHLY
  DAILY
}

enum PayPeriod {
  WEEKLY
  MONTHLY
}

enum AttendanceStatus {
  PRESENT
  /// Half a day worked, half a day paid.
  HALF
  /// Away and paid — annual leave, a public holiday.
  LEAVE
  /// Away and not paid.
  ABSENT
}

enum StockKind {
  /// A catalogue piece sitting in a store.
  PRODUCT
  /// Timber, foam, glue — what the factory consumes.
  MATERIAL
}

enum StockDirection {
  IN
  OUT
}

/// Why stock moved. The reason is what makes a stock report readable: a shelf
/// that dropped by four tells you nothing until you know whether they were
/// sold, damaged, or counted wrong.
enum StockReason {
  OPENING
  PURCHASE
  PRODUCTION
  SALE
  RETURN
  TRANSFER
  ADJUSTMENT
  DAMAGE
  STOCKTAKE
}

enum ExpenseCategory {
  MATERIALS
  SALARIES
  RENT
  UTILITIES
  TRANSPORT
  MAINTENANCE
  MARKETING
  OTHER
  // Money in that is not a customer paying for an order.
  CAPITAL
  REFUND
  OTHER_INCOME
  // Both halves of a move between two of your own accounts.
  TRANSFER
}

/// One movement of money. Never edited — a mistake is corrected by its reverse,
/// so the cash box can always be re-derived from the entries themselves.
model CashEntry {
  id                String           @id @default(uuid())
  accountId         String
  account           CashAccount      @relation(fields: [accountId], references: [id])
  direction         CashDirection
  amount            Decimal          @db.Decimal(14, 2)
  method            PaymentMethod    @default(CASH)
  /// The day the money actually moved, which is not always the day it was typed.
  occurredOn        DateTime
  /// Collected against a customer's order.
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id])
  /// Paid against a supplier's invoice.
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  /// Set on money out that is neither a supplier invoice nor a refund.
  category          ExpenseCategory?
  reference         String?
  note              String?
  /// The voucher number, from its own series — receipts and payments are
  /// counted separately, as they are on paper.
  voucherNo         String?          @unique
  /// Settlement discount: money written off to close the balance. A customer
  /// who owes 10,000 and hands over 9,500 by agreement has settled, and the
  /// 500 has to go somewhere rather than sitting as a debt nobody will chase.
  discount          Decimal          @default(0) @db.Decimal(14, 2)
  /// Whose money it was. A voucher without a name on it is not a voucher.
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  /// Both halves of a transfer share one id, so the pair can be shown as the
  /// single movement it actually is.
  transferId        String?
  /// Set when this entry exists only to undo another.
  reversesId        String?          @unique
  reverses          CashEntry?       @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy        CashEntry?       @relation("Reversal")
  actorId           String?
  actor             User?            @relation("CashEntryAuthor", fields: [actorId], references: [id])
  createdAt         DateTime         @default(now())

  payrollLine PayrollLine?

  @@index([occurredOn])
  @@index([orderId])
  @@index([accountId, occurredOn])
  @@index([transferId])
}

/// Who was in, on which day.
///
/// One row per person per day, because that is how it is actually taken: a
/// name and a tick each morning. Everything the weekly payroll needs comes
/// from counting these, so a wage can always be traced back to the days behind
/// it rather than to somebody's memory.
model Attendance {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("AttendanceOf", fields: [userId], references: [id])
  /// Midday UTC on the day in question, so a timezone cannot shift it a day.
  day       DateTime
  status    AttendanceStatus @default(PRESENT)
  /// Hours beyond the normal day, paid at the overtime rate on the payslip.
  overtimeHours Decimal      @default(0) @db.Decimal(6, 2)
  note      String?
  actorId   String?
  actor     User?            @relation("AttendanceAuthor", fields: [actorId], references: [id])
  createdAt DateTime         @default(now())

  @@unique([userId, day])
  @@index([day])
}

/// A month's wages, posted in one go. Unique on the month because paying
/// August twice is the mistake this exists to prevent.
model PayrollRun {
  id        String        @id @default(uuid())
  /// The period key: "2026-08" for a month, "2026-W35" for a week. The column
  /// is still called month, because renaming it on a live server would throw
  /// away the runs already posted.
  period    String        @unique @map("month")
  kind      PayPeriod     @default(MONTHLY)
  /// The days the period covers, so a payslip can say which week it was.
  periodStart DateTime?
  periodEnd   DateTime?
  accountId String
  account   CashAccount   @relation(fields: [accountId], references: [id])
  postedAt  DateTime      @default(now())
  actorId   String?
  actor     User?         @relation("PayrollAuthor", fields: [actorId], references: [id])
  note      String?

  lines PayrollLine[]
}

/// What changes about one person's pay in one month: overtime worked, an
/// advance already taken, a deduction. Entered before the month is posted and
/// kept afterwards as part of why the payslip said what it said.
model PayrollAdjustment {
  id         String  @id @default(uuid())
  /// The period key this belongs to — "2026-08" or "2026-W35".
  period     String  @map("month")
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  overtime   Decimal @default(0) @db.Decimal(14, 2)
  bonus      Decimal @default(0) @db.Decimal(14, 2)
  /// Money already handed over during the month, taken off the payslip.
  advance    Decimal @default(0) @db.Decimal(14, 2)
  /// Absence, damage, anything held back.
  deduction  Decimal @default(0) @db.Decimal(14, 2)
  /// Social insurance withheld from the wage.
  insurance  Decimal @default(0) @db.Decimal(14, 2)
  note       String?

  @@unique([period, userId])
}

model PayrollLine {
  id      String     @id @default(uuid())
  runId   String
  run     PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id])
  /// The wage before anything was added or held back, kept so a posted
  /// payslip can still be explained a year later.
  baseSalary Decimal @default(0) @db.Decimal(14, 2)
  /// For anybody paid by the day: the rate, and the days that earned it.
  dayRate    Decimal @default(0) @db.Decimal(14, 2)
  daysWorked Decimal @default(0) @db.Decimal(6, 2)
  overtime   Decimal @default(0) @db.Decimal(14, 2)
  bonus      Decimal @default(0) @db.Decimal(14, 2)
  advance    Decimal @default(0) @db.Decimal(14, 2)
  deduction  Decimal @default(0) @db.Decimal(14, 2)
  insurance  Decimal @default(0) @db.Decimal(14, 2)
  /// Net: what actually left the drawer.
  amount  Decimal    @db.Decimal(14, 2)
  /// The cash movement this payslip caused.
  entryId String?    @unique
  entry   CashEntry? @relation(fields: [entryId], references: [id])

  @@unique([runId, userId])
}

/// What was on the supplier's paper. Free text rather than a product link:
/// most of what a furniture factory buys — timber, foam, glue, a repair — is
/// not in the catalogue and never will be.
model PurchaseInvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Decimal         @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal         @db.Decimal(14, 2)
  discount    Decimal         @default(0) @db.Decimal(14, 2)
  warehouseId String?
  warehouse   Location?       @relation(fields: [warehouseId], references: [id])
  /// Set when this line is something the store actually holds, so receiving
  /// the bill puts it on a shelf. Most lines are not — a repair or a delivery
  /// charge is on the invoice but never in stock.
  stockItemId String?
}

/// What one of a product is made of.
///
/// Without this a work order knows what it is building but not what goes into
/// it, and materials can only ever come off the shelf by hand — which means
/// they mostly do not, and the timber figure drifts until a stocktake finds it.
model BomLine {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  /// How much of it one finished piece takes.
  qty         Decimal   @db.Decimal(14, 3)
  note        String?

  @@unique([productId, stockItemId])
}

/// Something the store holds a quantity of.
///
/// Not the same thing as a catalogue product: a factory stocks timber, foam and
/// glue that will never appear in a showroom, and a showroom holds pieces the
/// catalogue does list. So a stock item stands on its own and *may* point at a
/// product, rather than every product silently becoming stock.
model StockItem {
  id           String       @id @default(uuid())
  sku          String       @unique
  nameAr       String
  nameEn       String
  kind         StockKind    @default(MATERIAL)
  /// متر، كيلو، قطعة — printed beside every quantity, because "12" of an
  /// unknown unit is not a stock figure.
  unit         String       @default("قطعة")
  /// Below this, the item is flagged as running out. Zero means never flag it.
  reorderLevel Decimal      @default(0) @db.Decimal(14, 3)
  /// What one costs, for valuing what is on the shelf.
  unitCost     Decimal      @default(0) @db.Decimal(14, 2)
  /// Set when this item is a catalogue product, so selling one moves it.
  productId    String?      @unique
  product      Product?     @relation(fields: [productId], references: [id])
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  movements       StockMovement[]
  stocktakeLines  StocktakeLine[]
  bomLines        BomLine[]
}

/// One movement of stock, in or out of one store.
///
/// Append-only, exactly like the cash book: the quantity on a shelf is
/// re-derived by summing movements rather than kept as a number somebody edits.
/// A wrong movement is corrected by its reverse, so both stay on the record and
/// the balance still comes out right.
model StockMovement {
  id                String            @id @default(uuid())
  itemId            String
  item              StockItem         @relation(fields: [itemId], references: [id])
  warehouseId       String
  warehouse         Location          @relation(fields: [warehouseId], references: [id])
  direction         StockDirection
  qty               Decimal           @db.Decimal(14, 3)
  reason            StockReason
  /// The cost on the day it moved, for valuation.
  unitCost          Decimal           @default(0) @db.Decimal(14, 2)
  /// Which lot this was — a timber shipment, a dye batch. Optional, because
  /// most of what a factory holds is not worth tracking to a lot, and forcing
  /// one would just get "1" typed into every movement.
  batch             String?
  occurredOn        DateTime
  /// What caused it, where there was a cause.
  orderLineId       String?
  purchaseInvoiceId String?
  stocktakeId       String?
  stocktake         Stocktake?        @relation(fields: [stocktakeId], references: [id])
  /// Both halves of a move between two stores share one id.
  transferId        String?
  note              String?
  reversesId        String?           @unique
  reverses          StockMovement?    @relation("StockReversal", fields: [reversesId], references: [id])
  reversedBy        StockMovement?    @relation("StockReversal")
  actorId           String?
  actor             User?             @relation("StockAuthor", fields: [actorId], references: [id])
  createdAt         DateTime          @default(now())

  /// Set on a movement caused by building something, so consuming twice for
  /// the same work order cannot happen.
  workOrderId       String?

  @@index([itemId, warehouseId])
  @@index([itemId, batch])
  @@index([workOrderId])
  @@index([occurredOn])
  @@index([transferId])
}

/// الجرد — counting what is actually on the shelf against what the system
/// thinks. The difference is posted as movements with a reason, never as a
/// silent correction of the balance.
model Stocktake {
  id          String          @id @default(uuid())
  warehouseId String
  warehouse   Location        @relation(fields: [warehouseId], references: [id])
  startedAt   DateTime        @default(now())
  postedAt    DateTime?
  note        String?
  actorId     String?
  actor       User?           @relation("StocktakeAuthor", fields: [actorId], references: [id])

  lines     StocktakeLine[]
  movements StockMovement[]
}

model StocktakeLine {
  id          String    @id @default(uuid())
  stocktakeId String
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id])
  /// What the books said when the count was taken, frozen so the variance can
  /// still be explained after the adjustment has moved the balance.
  expected    Decimal   @db.Decimal(14, 3)
  counted     Decimal   @db.Decimal(14, 3)
  note        String?

  @@unique([stocktakeId, itemId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  invoices PurchaseInvoice[]
  entries  CashEntry[]
}

/// فاتورة مشتريات — what a supplier billed us.
model PurchaseInvoice {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  /// The supplier's own invoice number, as printed on their paper.
  number     String
  issuedOn   DateTime
  /// Which store took the goods in.
  warehouseId String?
  /// Before discount and tax.
  subtotal   Decimal  @default(0) @db.Decimal(14, 2)
  discount   Decimal  @default(0) @db.Decimal(14, 2)
  /// Tax the supplier charged us — input VAT, deductible against what we
  /// charged our own customers.
  taxRate    Decimal  @default(0) @db.Decimal(5, 2)
  taxTotal   Decimal  @default(0) @db.Decimal(14, 2)
  /// What the supplier is actually owed: subtotal − discount + tax.
  amount     Decimal  @db.Decimal(14, 2)
  note       String?
  actorId    String?
  actor      User?    @relation("PurchaseAuthor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  entries CashEntry[]
  lines   PurchaseInvoiceLine[]

  @@unique([supplierId, number])
  @@index([issuedOn])
}
