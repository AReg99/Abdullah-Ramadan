// Aura — Phase 1 (the tracking spine).
// Mirrors docs/04-data-model.md. Later phases add materials, BOM, logistics,
// finance and after-sales; the seams for those are noted in the docs, not stubbed here.

generator client {
  provider      = "prisma-client-js"
  // Built inside Alpine containers that may be x86 or Arm — Hetzner's cheapest
  // plans are Ampere Arm. Declaring both targets means the same image builds on
  // either, instead of failing at runtime with a missing query engine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

enum RoleKey {
  OWNER
  FACTORY_MANAGER
  SUPERVISOR
  GROUP_LEADER
  QC
  STOREKEEPER
  SHOWROOM_MANAGER
  SALES_REP
  DRIVER
  ACCOUNTANT
}

enum Locale {
  ar
  en
}

model Role {
  id          String  @id @default(uuid())
  key         RoleKey @unique
  nameAr      String
  nameEn      String
  permissions Json    @default("[]")
  users       User[]
}

/// People. Only some of them sign in.
///
/// The floor runs on groups: a group leader carries the phone and operates the
/// app, and the workers in their group do not sign in at all. Workers still
/// exist as records so output and rework stay attributable to the people who
/// did the work — losing that would cost the productivity and quality reports.
model User {
  id           String    @id @default(uuid())
  nameAr       String
  nameEn       String
  /// Unique only where present: roster workers have no phone and never sign in.
  phone        String?   @unique
  email        String?   @unique
  passwordHash String?
  /// False for roster workers — they are tracked, not authenticated.
  canLogin     Boolean   @default(true)
  locale       Locale    @default(ar)
  isActive     Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  stationId    String?
  station      Station?  @relation(fields: [stationId], references: [id])
  /// The group this person belongs to, whether as leader or member.
  groupId      String?
  group        Group?    @relation("GroupMembers", fields: [groupId], references: [id])
  /// Showroom staff belong to a location; a null means "every showroom".
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  createdAt    DateTime  @default(now())

  leads         Group[]           @relation("GroupLeader")
  stages        WorkOrderStage[]
  stageWork     StageWorker[]
  photos        StagePhoto[]
  events        TrackingEvent[]
  otps          OtpCode[]
  uploads       OrderAttachment[] @relation("AttachmentAuthor")
  productPhotos ProductPhoto[]    @relation("ProductPhotoAuthor")
}

/// A crew working one station under one leader.
model Group {
  id        String   @id @default(uuid())
  nameAr    String
  nameEn    String
  stationId String
  station   Station  @relation(fields: [stationId], references: [id])
  leaderId  String?
  leader    User?    @relation("GroupLeader", fields: [leaderId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  members User[]           @relation("GroupMembers")
  stages  WorkOrderStage[]
}

/// Which workers were actually on a stage. The leader records this when they
/// start the job, so a stage has both an operator (the leader) and a crew.
model StageWorker {
  id               String         @id @default(uuid())
  workOrderStageId String
  workOrderStage   WorkOrderStage @relation(fields: [workOrderStageId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])

  @@unique([workOrderStageId, userId])
}

model OtpCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- places

enum LocationType {
  FACTORY
  SHOWROOM
  WAREHOUSE
}

model Location {
  id       String          @id @default(uuid())
  type     LocationType
  nameAr   String
  nameEn   String
  address  String?
  stations Station[]
  orders   Order[]
  events   TrackingEvent[]
  staff    User[]
}

model Station {
  id                   String   @id @default(uuid())
  code                 String   @unique
  nameAr               String
  nameEn               String
  locationId           String
  location             Location @relation(fields: [locationId], references: [id])
  dailyCapacityMinutes Int      @default(480)
  isActive             Boolean  @default(true)

  users         User[]
  groups        Group[]
  routingStages RoutingStage[]
  events        TrackingEvent[]
}

// ---------------------------------------------------------------- catalogue

model ProductCategory {
  id       String    @id @default(uuid())
  nameAr   String
  nameEn   String
  products Product[]
  routings Routing[]
}

enum ProductKind {
  STANDARD
  CUSTOMIZABLE
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  nameAr         String
  nameEn         String
  kind           ProductKind     @default(STANDARD)
  basePrice      Decimal         @db.Decimal(14, 2)
  baseLeadDays   Int             @default(14)
  /// The line the showroom reads to the customer. Marketing copy, not a spec.
  description    String?
  warrantyMonths Int             @default(24)
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id])
  isActive       Boolean         @default(true)

  orderLines OrderLine[]
  workOrders WorkOrder[]
  photos     ProductPhoto[]
}

// ---------------------------------------------------------------- sales

model Customer {
  id       String  @id @default(uuid())
  name     String
  phone    String
  whatsapp String?
  email    String?
  address  String?
  locale   Locale  @default(ar)
  orders   Order[]
}

enum OrderKind {
  STANDARD
  CUSTOM
  MIXED
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

enum OrderChannel {
  SHOWROOM
  FACTORY
  ONLINE
}

enum OrderStatus {
  DRAFT
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CLOSED
  CANCELLED
}

enum LineKind {
  STANDARD
  CUSTOM
}

enum LineStatus {
  PENDING
  QUEUED
  IN_PRODUCTION
  /// Made, still in the factory, waiting to be sent.
  FINISHED
  /// Left the factory, not yet signed for at the showroom.
  IN_TRANSIT
  /// At the showroom, waiting for the customer.
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id            String       @id @default(uuid())
  code          String       @unique
  kind          OrderKind    @default(STANDARD)
  channel       OrderChannel @default(SHOWROOM)
  status        OrderStatus  @default(CONFIRMED)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  showroomId    String?
  showroom      Location?    @relation(fields: [showroomId], references: [id])
  promisedDate  DateTime?
  total         Decimal      @default(0) @db.Decimal(14, 2)
  paidTotal     Decimal      @default(0) @db.Decimal(14, 2)
  currency      String       @default("EGP")
  trackingToken String       @unique
  createdAt     DateTime     @default(now())

  lines       OrderLine[]
  events      TrackingEvent[]
  attachments OrderAttachment[]

  @@index([status, promisedDate])
}

/**
 * What the piece looks like. A catalogue with no pictures is a price list: the
 * showroom cannot show it, and the leader building it cannot check what they
 * are aiming at.
 */
model ProductPhoto {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  filename   String
  path       String
  mime       String
  bytes      Int      @default(0)
  /// Lowest first. The first is the one shown wherever there is room for one.
  sortOrder  Int      @default(0)
  uploadedAt DateTime @default(now())
  actorId    String?
  actor      User?    @relation("ProductPhotoAuthor", fields: [actorId], references: [id])

  @@index([productId, sortOrder])
}

/**
 * What the customer brought with the order: a photo of the piece they want
 * copied, a room measurement, a signed quotation. The showroom has it in hand
 * at the moment of sale and the factory needs it three weeks later, which is
 * exactly the gap a paper folder loses it in.
 */
model OrderAttachment {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       AttachmentKind @default(IMAGE)
  filename   String
  path       String
  mime       String
  bytes      Int            @default(0)
  note       String?
  uploadedAt DateTime       @default(now())
  actorId    String?
  actor      User?          @relation("AttachmentAuthor", fields: [actorId], references: [id])

  @@index([orderId])
}

model OrderLine {
  id           String     @id @default(uuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qty          Int        @default(1)
  unitPrice    Decimal    @db.Decimal(14, 2)
  lineKind     LineKind   @default(STANDARD)
  status       LineStatus @default(PENDING)
  promisedDate DateTime?
  specNotes    String?
  /// Handover milestones, projected from the event stream for cheap reads.
  dispatchedAt DateTime?
  receivedAt   DateTime?
  deliveredAt  DateTime?

  workOrders WorkOrder[]

  @@index([status, promisedDate])
}

// ---------------------------------------------------------------- production

model Routing {
  id         String           @id @default(uuid())
  nameAr     String
  nameEn     String
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  isDefault  Boolean          @default(false)
  stages     RoutingStage[]
  workOrders WorkOrder[]
}

/// Photo gates, per stage and per direction. See docs/03-order-lifecycle.md.
enum PhotoRule {
  OFF
  OPTIONAL
  REQUIRED
}

model RoutingStage {
  id                String    @id @default(uuid())
  routingId         String
  routing           Routing   @relation(fields: [routingId], references: [id], onDelete: Cascade)
  seq               Int
  key               String
  nameAr            String
  nameEn            String
  stationId         String
  station           Station   @relation(fields: [stationId], references: [id])
  stdMinutes        Int
  isCustomerVisible Boolean   @default(false)
  photoBefore       PhotoRule @default(OFF)
  photoAfter        PhotoRule @default(OFF)
  photoMinCount     Int       @default(1)

  workOrderStages WorkOrderStage[]

  @@unique([routingId, seq])
}

enum WorkOrderStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
}

model WorkOrder {
  id           String          @id @default(uuid())
  code         String          @unique
  orderLineId  String
  orderLine    OrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  qty          Int             @default(1)
  routingId    String
  routing      Routing         @relation(fields: [routingId], references: [id])
  status       WorkOrderStatus @default(PENDING)
  priority     Int             @default(0)
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  createdAt    DateTime        @default(now())

  stages WorkOrderStage[]
  labels UnitLabel[]
  photos StagePhoto[]
}

enum StageStatus {
  PENDING
  READY
  IN_PROGRESS
  PAUSED
  DONE
  /// The order was cancelled before this stage was worked. Distinct from
  /// PENDING, which means it is still coming.
  CANCELLED
}

/// Fixed list — free text cannot be reported on. docs/03-order-lifecycle.md.
enum BlockedReason {
  NO_MATERIAL
  MACHINE_DOWN
  AWAITING_DRAWING
  AWAITING_QC
  AWAITING_CUSTOMER
  MISSING_COMPONENT
  POWER
  LABOUR_SHORT
  OTHER
}

model WorkOrderStage {
  id             String         @id @default(uuid())
  workOrderId    String
  workOrder      WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  routingStageId String
  routingStage   RoutingStage   @relation(fields: [routingStageId], references: [id])
  seq            Int
  status         StageStatus    @default(PENDING)
  /// The leader who operated the app for this stage.
  assignedToId   String?
  assignedTo     User?          @relation(fields: [assignedToId], references: [id])
  /// The crew it was assigned to.
  groupId        String?
  group          Group?         @relation(fields: [groupId], references: [id])
  startedAt      DateTime?
  finishedAt     DateTime?
  actualMinutes  Int            @default(0)
  blockedReason  BlockedReason?
  blockedNote    String?
  blockedMinutes Int            @default(0)
  pausedAt       DateTime?

  photos  StagePhoto[]
  workers StageWorker[]

  @@unique([workOrderId, seq])
  @@index([status])
}

model UnitLabel {
  id          String       @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  serial      String       @unique
  printedAt   DateTime?
  scrapped    Boolean      @default(false)
  photos      StagePhoto[]
}

enum PhotoKind {
  BEFORE
  AFTER
  ISSUE
  EXTRA
}

model StagePhoto {
  id                String         @id @default(uuid())
  workOrderStageId  String
  workOrderStage    WorkOrderStage @relation(fields: [workOrderStageId], references: [id], onDelete: Cascade)
  workOrderId       String
  workOrder         WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  unitLabelId       String?
  unitLabel         UnitLabel?     @relation(fields: [unitLabelId], references: [id])
  kind              PhotoKind
  path              String
  bytes             Int            @default(0)
  width             Int            @default(0)
  height            Int            @default(0)
  capturedAt        DateTime
  uploadedAt        DateTime       @default(now())
  actorId           String
  actor             User           @relation(fields: [actorId], references: [id])
  clientEventId     String         @unique
  isCustomerVisible Boolean        @default(false)
  caption           String?

  @@index([workOrderStageId, kind])
}

// ---------------------------------------------------------------- the event stream

/// Append-only. Nothing is ever updated; a mistake is corrected by a new
/// compensating event. occurredAt is the device clock; recordedAt is the server's,
/// so an offline scan still counts at the minute it happened.
model TrackingEvent {
  id                String    @id @default(uuid())
  code              String
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id])
  entityType        String
  entityId          String
  actorId           String?
  actor             User?     @relation(fields: [actorId], references: [id])
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id])
  stationId         String?
  station           Station?  @relation(fields: [stationId], references: [id])
  payload           Json      @default("{}")
  occurredAt        DateTime
  recordedAt        DateTime  @default(now())
  isCustomerVisible Boolean   @default(false)
  clientEventId     String?   @unique

  @@index([orderId, occurredAt])
  @@index([code, occurredAt])
  @@index([occurredAt])
}
