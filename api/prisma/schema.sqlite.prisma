  seq               Int
  key               String
  nameAr            String
  nameEn            String
  stationId         String
  station           Station   @relation(fields: [stationId], references: [id])
  stdMinutes        Int
  isCustomerVisible Boolean   @default(false)
  photoBefore       String @default("OFF")
  photoAfter        String @default("OFF")
  photoMinCount     Int       @default(1)

  workOrderStages WorkOrderStage[]

  @@unique([routingId, seq])
}


model WorkOrder {
  id           String          @id @default(uuid())
  code         String          @unique
  orderLineId  String
  orderLine    OrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  qty          Int             @default(1)
  routingId    String
  routing      Routing         @relation(fields: [routingId], references: [id])
  status       String @default("PENDING")
  priority     Int             @default(0)
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  createdAt    DateTime        @default(now())

  stages WorkOrderStage[]
