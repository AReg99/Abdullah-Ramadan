// ---------------------------------------------------------------- the event stream

/// Append-only. Nothing is ever updated; a mistake is corrected by a new
/// compensating event. occurredAt is the device clock; recordedAt is the server's,
/// so an offline scan still counts at the minute it happened.
model TrackingEvent {
  id                String    @id @default(uuid())
  code              String
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id])
  entityType        String
  entityId          String
  actorId           String?
  actor             User?     @relation(fields: [actorId], references: [id])
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id])
  stationId         String?
  station           Station?  @relation(fields: [stationId], references: [id])
  payload           Json
  occurredAt        DateTime
  recordedAt        DateTime  @default(now())
  isCustomerVisible Boolean   @default(false)
  clientEventId     String?   @unique

  @@index([orderId, occurredAt])
  @@index([code, occurredAt])
  @@index([occurredAt])
}

// ─────────────────────────────────────────────────────────── money
// Every movement of money is one CashEntry against one account. A collection
// from a customer, a payment to a supplier and a running expense are the same
// shape — direction, amount, where it landed — which is what makes the cash box
// add up without a second set of books to reconcile against.


/// A drawer or a bank account. الخزنة.
model CashAccount {
  id             String          @id @default(uuid())
  code           String          @unique
  nameAr         String
  nameEn         String
  kind           String @default("CASH")
  /// What was in it the day the books opened here.
  openingBalance Decimal         @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  entries     CashEntry[]
  payrollRuns PayrollRun[]
}



/// What money out of the drawer was for, when it was not a supplier invoice.
/// What a movement was for, in or out. The name is historical — it started as
/// expenses only — and is left alone because renaming a live enum is a
/// migration nobody needs.

/// One movement of money. Never edited — a mistake is corrected by its reverse,
/// so the cash box can always be re-derived from the entries themselves.
model CashEntry {
  id                String           @id @default(uuid())
  accountId         String
  account           CashAccount      @relation(fields: [accountId], references: [id])
  direction         String
  amount            Decimal
  method            String    @default("CASH")
  /// The day the money actually moved, which is not always the day it was typed.
  occurredOn        DateTime
  /// Collected against a customer's order.
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id])
  /// Paid against a supplier's invoice.
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  /// Set on money out that is neither a supplier invoice nor a refund.
  category          String?
  reference         String?
  note              String?
  /// Both halves of a transfer share one id, so the pair can be shown as the
  /// single movement it actually is.
  transferId        String?
  /// Set when this entry exists only to undo another.
  reversesId        String?          @unique
  reverses          CashEntry?       @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy        CashEntry?       @relation("Reversal")
  actorId           String?
  actor             User?            @relation("CashEntryAuthor", fields: [actorId], references: [id])
  createdAt         DateTime         @default(now())

  payrollLine PayrollLine?

  @@index([occurredOn])
  @@index([orderId])
  @@index([accountId, occurredOn])
  @@index([transferId])
}

/// A month's wages, posted in one go. Unique on the month because paying
/// August twice is the mistake this exists to prevent.
model PayrollRun {
  id        String        @id @default(uuid())
  /// "2026-08" — the month being paid, not the day it was posted.
  month     String        @unique
  accountId String
  account   CashAccount   @relation(fields: [accountId], references: [id])
  postedAt  DateTime      @default(now())
  actorId   String?
  actor     User?         @relation("PayrollAuthor", fields: [actorId], references: [id])
  note      String?

  lines PayrollLine[]
}

model PayrollLine {
  id      String     @id @default(uuid())
  runId   String
  run     PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id])
  amount  Decimal
  /// The cash movement this payslip caused.
  entryId String?    @unique
  entry   CashEntry? @relation(fields: [entryId], references: [id])

  @@unique([runId, userId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  invoices PurchaseInvoice[]
}

/// فاتورة مشتريات — what a supplier billed us.
model PurchaseInvoice {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  /// The supplier's own invoice number, as printed on their paper.
  number     String
  issuedOn   DateTime
  amount     Decimal
  note       String?
  actorId    String?
  actor      User?    @relation("PurchaseAuthor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  entries CashEntry[]

  @@unique([supplierId, number])
  @@index([issuedOn])
}
