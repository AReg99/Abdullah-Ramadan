/// One verdict on one QC gate.
///
/// The verdict is a record of its own rather than a status on the stage,
/// because a piece can be inspected more than once: rejected, reworked, and
/// inspected again. Keeping each pass means "how many went back" is a question
/// with an answer.
model Inspection {
  id            String           @id @default(uuid())
  stageId       String
  stage         WorkOrderStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  workOrderId   String
  workOrder     WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  result        String
  /// How many of the units on this work order the verdict covers.
  qty           Int              @default(1)
  /// Where a rework was sent back to, by sequence within the routing.
  reworkToSeq   Int?
  note          String?
  inspectorId   String?
  inspector     User?            @relation("InspectionAuthor", fields: [inspectorId], references: [id])
  createdAt     DateTime         @default(now())

  defects InspectionDefect[]

  @@index([workOrderId])
  @@index([createdAt])
}

/// What was wrong, and who is answerable for it.
///
/// The station and the crew are recorded because the whole point of a defect
