// ---------------------------------------------------------------- the event stream

/// Append-only. Nothing is ever updated; a mistake is corrected by a new
/// compensating event. occurredAt is the device clock; recordedAt is the server's,
/// so an offline scan still counts at the minute it happened.
model TrackingEvent {
  id                String    @id @default(uuid())
  code              String
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id])
  entityType        String
  entityId          String
  actorId           String?
  actor             User?     @relation(fields: [actorId], references: [id])
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id])
  stationId         String?
  station           Station?  @relation(fields: [stationId], references: [id])
  payload           Json
  occurredAt        DateTime
  recordedAt        DateTime  @default(now())
  isCustomerVisible Boolean   @default(false)
  clientEventId     String?   @unique

  @@index([orderId, occurredAt])
  @@index([code, occurredAt])
  @@index([occurredAt])
}

// ─────────────────────────────────────────────────────────── money
// Every movement of money is one CashEntry against one account. A collection
// from a customer, a payment to a supplier and a running expense are the same
// shape — direction, amount, where it landed — which is what makes the cash box
// add up without a second set of books to reconcile against.


/// A drawer or a bank account. الخزنة.
model CashAccount {
  id             String          @id @default(uuid())
  code           String          @unique
  nameAr         String
  nameEn         String
  kind           String @default("CASH")
  /// What was in it the day the books opened here.
  openingBalance Decimal         @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  entries     CashEntry[]
  payrollRuns PayrollRun[]
}



/// What money out of the drawer was for, when it was not a supplier invoice.
/// What a movement was for, in or out. The name is historical — it started as
/// expenses only — and is left alone because renaming a live enum is a
/// migration nobody needs.







/// Why stock moved. The reason is what makes a stock report readable: a shelf
/// that dropped by four tells you nothing until you know whether they were
/// sold, damaged, or counted wrong.


/// One movement of money. Never edited — a mistake is corrected by its reverse,
/// so the cash box can always be re-derived from the entries themselves.
model CashEntry {
  id                String           @id @default(uuid())
  accountId         String
  account           CashAccount      @relation(fields: [accountId], references: [id])
  direction         String
  amount            Decimal
  method            String    @default("CASH")
  /// The day the money actually moved, which is not always the day it was typed.
  occurredOn        DateTime
  /// Collected against a customer's order.
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id])
  /// Paid against a supplier's invoice.
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  /// Set on money out that is neither a supplier invoice nor a refund.
  category          String?
  reference         String?
  note              String?
  /// The voucher number, from its own series — receipts and payments are
  /// counted separately, as they are on paper.
  voucherNo         String?          @unique
  /// Settlement discount: money written off to close the balance. A customer
  /// who owes 10,000 and hands over 9,500 by agreement has settled, and the
  /// 500 has to go somewhere rather than sitting as a debt nobody will chase.
  discount          Decimal          @default(0)
  /// Whose money it was. A voucher without a name on it is not a voucher.
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  /// Both halves of a transfer share one id, so the pair can be shown as the
  /// single movement it actually is.
  transferId        String?
  /// Set when this entry exists only to undo another.
  reversesId        String?          @unique
  reverses          CashEntry?       @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy        CashEntry?       @relation("Reversal")
  actorId           String?
  actor             User?            @relation("CashEntryAuthor", fields: [actorId], references: [id])
  createdAt         DateTime         @default(now())

  payrollLine PayrollLine?

  @@index([occurredOn])
  @@index([orderId])
  @@index([accountId, occurredOn])
  @@index([transferId])
}

/// Who was in, on which day.
///
/// One row per person per day, because that is how it is actually taken: a
/// name and a tick each morning. Everything the weekly payroll needs comes
/// from counting these, so a wage can always be traced back to the days behind
/// it rather than to somebody's memory.
model Attendance {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("AttendanceOf", fields: [userId], references: [id])
  /// Midday UTC on the day in question, so a timezone cannot shift it a day.
  day       DateTime
  status    String @default("PRESENT")
  /// Hours beyond the normal day, paid at the overtime rate on the payslip.
  overtimeHours Decimal      @default(0)
  note      String?
  actorId   String?
  actor     User?            @relation("AttendanceAuthor", fields: [actorId], references: [id])
  createdAt DateTime         @default(now())

  @@unique([userId, day])
  @@index([day])
}

/// A month's wages, posted in one go. Unique on the month because paying
/// August twice is the mistake this exists to prevent.
model PayrollRun {
  id        String        @id @default(uuid())
  /// The period key: "2026-08" for a month, "2026-W35" for a week. The column
  /// is still called month, because renaming it on a live server would throw
  /// away the runs already posted.
  period    String        @unique @map("month")
  kind      String     @default("MONTHLY")
  /// The days the period covers, so a payslip can say which week it was.
  periodStart DateTime?
  periodEnd   DateTime?
  accountId String
  account   CashAccount   @relation(fields: [accountId], references: [id])
  postedAt  DateTime      @default(now())
  actorId   String?
  actor     User?         @relation("PayrollAuthor", fields: [actorId], references: [id])
  note      String?

  lines PayrollLine[]
}

/// What changes about one person's pay in one month: overtime worked, an
/// advance already taken, a deduction. Entered before the month is posted and
/// kept afterwards as part of why the payslip said what it said.
model PayrollAdjustment {
  id         String  @id @default(uuid())
  /// The period key this belongs to — "2026-08" or "2026-W35".
  period     String  @map("month")
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  overtime   Decimal @default(0)
  bonus      Decimal @default(0)
  /// Money already handed over during the month, taken off the payslip.
  advance    Decimal @default(0)
  /// Absence, damage, anything held back.
  deduction  Decimal @default(0)
  /// Social insurance withheld from the wage.
  insurance  Decimal @default(0)
  note       String?

  @@unique([period, userId])
}

model PayrollLine {
  id      String     @id @default(uuid())
  runId   String
  run     PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id])
  /// The wage before anything was added or held back, kept so a posted
  /// payslip can still be explained a year later.
  baseSalary Decimal @default(0)
  /// For anybody paid by the day: the rate, and the days that earned it.
  dayRate    Decimal @default(0)
  daysWorked Decimal @default(0)
  overtime   Decimal @default(0)
  bonus      Decimal @default(0)
  advance    Decimal @default(0)
  deduction  Decimal @default(0)
  insurance  Decimal @default(0)
  /// Net: what actually left the drawer.
  amount  Decimal
  /// The cash movement this payslip caused.
  entryId String?    @unique
  entry   CashEntry? @relation(fields: [entryId], references: [id])

  @@unique([runId, userId])
}

/// What was on the supplier's paper. Free text rather than a product link:
/// most of what a furniture factory buys — timber, foam, glue, a repair — is
/// not in the catalogue and never will be.
model PurchaseInvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Decimal         @default(1)
  unitPrice   Decimal
  discount    Decimal         @default(0)
  warehouseId String?
  warehouse   Location?       @relation(fields: [warehouseId], references: [id])
  /// Set when this line is something the store actually holds, so receiving
  /// the bill puts it on a shelf. Most lines are not — a repair or a delivery
  /// charge is on the invoice but never in stock.
  stockItemId String?
}

/// What one of a product is made of.
///
/// Without this a work order knows what it is building but not what goes into
/// it, and materials can only ever come off the shelf by hand — which means
/// they mostly do not, and the timber figure drifts until a stocktake finds it.
model BomLine {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  /// How much of it one finished piece takes.
  qty         Decimal
  note        String?

  @@unique([productId, stockItemId])
}

/// Something the store holds a quantity of.
///
/// Not the same thing as a catalogue product: a factory stocks timber, foam and
/// glue that will never appear in a showroom, and a showroom holds pieces the
/// catalogue does list. So a stock item stands on its own and *may* point at a
/// product, rather than every product silently becoming stock.
model StockItem {
  id           String       @id @default(uuid())
  sku          String       @unique
  nameAr       String
  nameEn       String
  kind         String    @default("MATERIAL")
  /// متر، كيلو، قطعة — printed beside every quantity, because "12" of an
  /// unknown unit is not a stock figure.
  unit         String       @default("قطعة")
  /// Below this, the item is flagged as running out. Zero means never flag it.
  reorderLevel Decimal      @default(0)
  /// What one costs, for valuing what is on the shelf.
  unitCost     Decimal      @default(0)
  /// Set when this item is a catalogue product, so selling one moves it.
  productId    String?      @unique
  product      Product?     @relation(fields: [productId], references: [id])
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  movements       StockMovement[]
  stocktakeLines  StocktakeLine[]
  bomLines        BomLine[]
  requestLines    PurchaseRequestLine[]
  orderLines      PurchaseOrderLine[]
}

/// One movement of stock, in or out of one store.
///
/// Append-only, exactly like the cash book: the quantity on a shelf is
/// re-derived by summing movements rather than kept as a number somebody edits.
/// A wrong movement is corrected by its reverse, so both stay on the record and
/// the balance still comes out right.
model StockMovement {
  id                String            @id @default(uuid())
  itemId            String
  item              StockItem         @relation(fields: [itemId], references: [id])
  warehouseId       String
  warehouse         Location          @relation(fields: [warehouseId], references: [id])
  direction         String
  qty               Decimal
  reason            String
  /// The cost on the day it moved, for valuation.
  unitCost          Decimal           @default(0)
  /// Which lot this was — a timber shipment, a dye batch. Optional, because
  /// most of what a factory holds is not worth tracking to a lot, and forcing
  /// one would just get "1" typed into every movement.
  batch             String?
  occurredOn        DateTime
  /// What caused it, where there was a cause.
  orderLineId       String?
  purchaseInvoiceId String?
  stocktakeId       String?
  stocktake         Stocktake?        @relation(fields: [stocktakeId], references: [id])
  /// Both halves of a move between two stores share one id.
  transferId        String?
  note              String?
  reversesId        String?           @unique
  reverses          StockMovement?    @relation("StockReversal", fields: [reversesId], references: [id])
  reversedBy        StockMovement?    @relation("StockReversal")
  actorId           String?
  actor             User?             @relation("StockAuthor", fields: [actorId], references: [id])
  createdAt         DateTime          @default(now())

  /// Set on a movement caused by building something, so consuming twice for
  /// the same work order cannot happen.
  workOrderId       String?

  @@index([itemId, warehouseId])
  @@index([itemId, batch])
  @@index([workOrderId])
  @@index([occurredOn])
  @@index([transferId])
}

/// الجرد — counting what is actually on the shelf against what the system
/// thinks. The difference is posted as movements with a reason, never as a
/// silent correction of the balance.
model Stocktake {
  id          String          @id @default(uuid())
  warehouseId String
  warehouse   Location        @relation(fields: [warehouseId], references: [id])
  startedAt   DateTime        @default(now())
  postedAt    DateTime?
  note        String?
  actorId     String?
  actor       User?           @relation("StocktakeAuthor", fields: [actorId], references: [id])

  lines     StocktakeLine[]
  movements StockMovement[]
}

model StocktakeLine {
  id          String    @id @default(uuid())
  stocktakeId String
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id])
  /// What the books said when the count was taken, frozen so the variance can
  /// still be explained after the adjustment has moved the balance.
  expected    Decimal
  counted     Decimal
  note        String?

  @@unique([stocktakeId, itemId])
}

/// طلب شراء — somebody on the floor saying they need something.
///
/// The system used to learn about a purchase from the supplier's invoice, which
/// is the last possible moment: by then the money is owed, nobody approved it,
/// and there is nothing to check the delivery against. This is the first
/// moment instead.
model PurchaseRequest {
  id          String                @id @default(uuid())
  number      String                @unique
  status      String @default("SUBMITTED")
  /// Where it is wanted.
  warehouseId String?
  warehouse   Location?             @relation(fields: [warehouseId], references: [id])
  neededBy    DateTime?
  note        String?
  requestedById String?
  requestedBy   User?               @relation("RequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?               @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  /// Why it was turned down. A refusal with no reason gets asked again next week.
  decisionNote  String?
  createdAt   DateTime              @default(now())

  lines  PurchaseRequestLine[]
  orders PurchaseOrder[]
}

model PurchaseRequestLine {
  id          String          @id @default(uuid())
  requestId   String
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem       @relation(fields: [stockItemId], references: [id])
  qty         Decimal
  note        String?

  @@unique([requestId, stockItemId])
}

/// أمر شراء — what was actually ordered, from whom, at what price.
model PurchaseOrder {
  id         String              @id @default(uuid())
  number     String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  requestId  String?
  request    PurchaseRequest?    @relation(fields: [requestId], references: [id])
  status     String @default("OPEN")
  warehouseId String?
  warehouse   Location?          @relation(fields: [warehouseId], references: [id])
  expectedOn DateTime?
  note       String?
  actorId    String?
  actor      User?               @relation("PurchaseOrderAuthor", fields: [actorId], references: [id])
  createdAt  DateTime            @default(now())

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  invoices PurchaseInvoice[]
  approvals Approval[]
}

model PurchaseOrderLine {
  id          String        @id @default(uuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem     @relation(fields: [stockItemId], references: [id])
  qty         Decimal
  unitPrice   Decimal
  note        String?

  receiptLines GoodsReceiptLine[]

  @@unique([orderId, stockItemId])
}

/// إذن استلام — what actually turned up.
///
/// Kept apart from the invoice on purpose. Without it nothing says what arrived
/// as opposed to what was billed, so nothing stops the business paying for a
/// delivery that never came.
model GoodsReceipt {
  id          String        @id @default(uuid())
  number      String        @unique
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id])
  warehouseId String
  warehouse   Location      @relation(fields: [warehouseId], references: [id])
  receivedOn  DateTime      @default(now())
  note        String?
  actorId     String?
  actor       User?         @relation("GoodsReceiptAuthor", fields: [actorId], references: [id])
  createdAt   DateTime      @default(now())

  lines GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id          String            @id @default(uuid())
  receiptId   String
  receipt     GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   PurchaseOrderLine @relation(fields: [orderLineId], references: [id])
  /// What was counted off the van, which is not always what the note says.
  qty         Decimal
  batch       String?
  note        String?
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  invoices PurchaseInvoice[]
  entries  CashEntry[]
  orders   PurchaseOrder[]
}

/// فاتورة مشتريات — what a supplier billed us.
model PurchaseInvoice {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  /// The purchase order this bills, where there was one. Without it the
  /// invoice can only be taken on trust.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  /// The supplier's own invoice number, as printed on their paper.
  number     String
  issuedOn   DateTime
  /// Which store took the goods in.
  warehouseId String?
  /// Before discount and tax.
  subtotal   Decimal  @default(0)
  discount   Decimal  @default(0)
  /// Tax the supplier charged us — input VAT, deductible against what we
  /// charged our own customers.
  taxRate    Decimal  @default(0)
  taxTotal   Decimal  @default(0)
  /// What the supplier is actually owed: subtotal − discount + tax.
  amount     Decimal
  note       String?
  actorId    String?
  actor      User?    @relation("PurchaseAuthor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  entries CashEntry[]
  lines   PurchaseInvoiceLine[]

  @@unique([supplierId, number])
  @@index([issuedOn])
}

// ------------------------------------------------------ limits & approvals

/// What each role may do on their own, before somebody has to be asked.
///
/// One row per role rather than a settings key per role: the values are read
/// together on every sale, and a table can be shown as a table.
///
/// A null is *no ceiling*, not a ceiling of zero. That distinction is the
/// whole upgrade story — a business that has never set a limit must not find
/// its showroom unable to sell the morning after a release.
model RoleLimit {
  id   String  @id @default(uuid())
  role String @unique
  /// The most this role may take off an order, as a percent of its gross.
  /// Percent rather than pounds because a hundred off a bedroom and a hundred
  /// off a stool are not the same concession.
  discountPct     Decimal?
  /// The largest purchase order this role may commit the business to.
  purchaseCeiling Decimal?
  updatedAt       DateTime @updatedAt
}



/// موافقة — permission to do one specific thing, once.
///
/// The showroom already rings the owner when a customer pushes for more off.
/// Nothing here changes that conversation; it changes whether the answer
/// survives it. An approval names the amount, the person who asked, the person
/// who answered, and what it was for — and is spent the moment it is used, so
/// a yes given for one sofa cannot be quietly reused on the next.
model Approval {
  id     String         @id @default(uuid())
  number String         @unique
  kind   String
  status String @default("PENDING")

  /// What is being asked for, in currency. A discount of this much, or a
  /// purchase order worth this much — never more when it is spent.
  amount  Decimal
  /// The ceiling that was exceeded, copied at the moment of asking so the
  /// record still reads correctly after somebody moves the limit.
  ceiling Decimal
  /// Who or what it concerns, in words: the customer, the supplier, the model.
  /// The approver is answering on their phone and cannot go and look.
  subject String
  /// Why the asker thinks it is worth it.
  reason  String?

  requestedById String
  requestedBy   User   @relation("ApprovalAsked", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?    @relation("ApprovalAnswered", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?

  /// Spent on this order or purchase order, whichever it authorised.
  usedAt  DateTime?
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  /// A yes left lying around gets spent on a different sale a fortnight later.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ----------------------------------------------------- warranty & after-sales




/// بلاغ ما بعد البيع — a customer's complaint about a piece already delivered.
///
/// Once a piece was handed over the system forgot it existed. A customer
/// ringing six months later about a sagging door reached a WhatsApp message
/// and somebody's memory: nothing said whether it was still under warranty,
/// nothing tracked the repair, and nothing learned which models keep coming
/// back — which is the only figure that would change what the factory builds.
model ServiceTicket {
  id     String        @id @default(uuid())
  number String        @unique
  status String @default("OPEN")
  kind   String   @default("WARRANTY")

  /// The piece, through the line it was sold on.
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id])
  /// The exact unit, where the label was scanned. A line can be three chairs
  /// and only one of them is broken.
  serial      String?

  /// What the customer said, in their words. Not a diagnosis.
  description  String
  /// The same taxonomy production uses, so a fault found in a customer's house
  /// and one found at the gate are the same kind of thing and can be counted
  /// together.
  defectTypeId String?
  defectType   DefectType? @relation(fields: [defectTypeId], references: [id])

  /// Copied at the moment the ticket was raised. The warranty period lives on
  /// the product and somebody will shorten it next year; a ticket that
  /// silently changes its own answer afterwards is worse than no record.
  underWarranty Boolean
  warrantyUntil DateTime?

  reportedById String
  reportedBy   User   @relation("ServiceReporter", fields: [reportedById], references: [id])
  assignedToId String?
  assignedTo   User?  @relation("ServiceAssignee", fields: [assignedToId], references: [id])
  /// When we told the customer somebody would come.
  promisedDate DateTime?

  resolution String?
  closedAt   DateTime?
  /// What the repair cost us — parts and time. The number that says whether a
  /// model is worth building.
  costAmount   Decimal @default(0)
  /// What the customer paid, where it was chargeable.
  chargeAmount Decimal @default(0)

  createdAt DateTime @default(now())
  visits    ServiceVisit[]

  @@index([status, createdAt])
}

/// One trip out to the customer. Append-only, because they go more than once:
/// the first visit finds it needs a part, the second fits it.
model ServiceVisit {
  id           String         @id @default(uuid())
  ticketId     String
  ticket       ServiceTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   User?          @relation("ServiceTechnician", fields: [technicianId], references: [id])
  outcome      String
  note         String?
  photoPath    String?
  occurredAt   DateTime       @default(now())
  createdAt    DateTime       @default(now())

  @@index([ticketId])
}

// -------------------------------------------------- leads & quotations



/// Why a customer did not buy. Six answers rather than a free text box: a
/// reason nobody can count is a reason nobody acts on, and "the price" being
/// half of them is a different business decision from "the lead time".

/// عميل محتمل — somebody who came in, or rang, and has not bought yet.
///
/// The showroom could record exactly one thing: a confirmed order. A customer
/// who walked in, was given a price and said they would think about it left no
/// trace at all — so nobody could be followed up, nobody knew how many walk-ins
/// became sales, and the next quote was retyped from nothing.
model Lead {
  id     String     @id @default(uuid())
  number String     @unique
  name   String
  phone  String
  whatsapp String?
  /// Linked once they buy, or from the start when they are already on the books.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  source String @default("WALK_IN")
  status String @default("NEW")
  /// What they are after, in the rep's own words. Not a spec.
  interest String?
  /// Roughly what it is worth, before anything is priced. A guess the rep is
  /// happy to make and nobody should treat as a figure.
  estimateValue Decimal?

  showroomId String?
  showroom   Location? @relation("LeadShowroom", fields: [showroomId], references: [id])
  /// The rep whose customer this is. Following up is somebody's job or it is
  /// nobody's.
  ownerId String
  owner   User   @relation("LeadOwner", fields: [ownerId], references: [id])

  /// When to ring them. The single field that turns a list of names into work.
  nextFollowUp DateTime?
  lostReason   String?
  lostNote     String?
  /// The order it became, where it did.
  wonOrderId String? @unique
  wonOrder   Order?  @relation("LeadWonOrder", fields: [wonOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes  LeadNote[]
  quotes Quotation[]

  @@index([status, nextFollowUp])
}

/// One conversation. Append-only: what was said in March is not edited in May.
model LeadNote {
  id      String   @id @default(uuid())
  leadId  String
  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?    @relation("LeadNoteAuthor", fields: [actorId], references: [id])
  note    String
  at      DateTime @default(now())

  @@index([leadId])
}


/// عرض سعر — a price put in writing, with a date it stops being true.
model Quotation {
  id     String      @id @default(uuid())
  number String      @unique
  status String @default("DRAFT")

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  /// A price for somebody already on the books, with no lead behind it.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// A price with no end date is a price the customer holds you to next year.
  validUntil DateTime

  subtotal      Decimal @default(0)
  discountTotal Decimal @default(0)
  taxRate       Decimal @default(0)
  taxTotal      Decimal @default(0)
  total         Decimal @default(0)
  currency      String  @default("EGP")

  note      String?
  actorId   String?
  actor     User?   @relation("QuoteAuthor", fields: [actorId], references: [id])
  /// The order it turned into. A quote is converted once.
  orderId   String? @unique
  order     Order?  @relation("QuoteOrder", fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  lines QuotationLine[]

  @@index([status, validUntil])
}

model QuotationLine {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  qty         Int       @default(1)
  unitPrice   Decimal
  discount    Decimal   @default(0)
  specNotes   String?
}
