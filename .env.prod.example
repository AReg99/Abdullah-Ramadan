# Copy to .env.prod and fill in. Never commit .env.prod.

# The domain pointing at this server. Caddy gets a certificate for it.
DOMAIN=aura.example.com

# openssl rand -hex 32
JWT_SECRET=

# Your owner account — this is how you first sign in.
OWNER_EMAIL=you@yourdomain.com
OWNER_PASSWORD=

# Only needed for docker-compose.prod.yml (PostgreSQL).
# openssl rand -hex 24
POSTGRES_PASSWORD=

# DEV_OTP is deliberately absent. The API refuses to start in production if it
# is set, because it would make a phone number the only credential needed.
